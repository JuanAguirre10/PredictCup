# Variables del stack Docker. NO subir a git con secretos reales (ver .gitignore).
# Valores por defecto pensados para correr el stack localmente.

# --- PostgreSQL ---
POSTGRES_USER=mundial
POSTGRES_PASSWORD=cambiame

# --- Backend: datasource (apunta al servicio 'postgres') ---
DATABASE_URL=jdbc:postgresql://postgres:5432/mundial_apuestas
DATABASE_USER=mundial
DATABASE_PASSWORD=cambiame

# --- Redis ---
REDIS_PASSWORD=cambiame
REDIS_URL=redis://:redispass@redis:6379

# --- OAuth Google (OIDC) ---
# Deshabilitado por defecto para que el stack arranque sin secretos.
# Para login real: pon GOOGLE_CLIENT_ID/SECRET y QUARKUS_OIDC_ENABLED=true.
QUARKUS_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# --- JWT / frontend ---
JWT_ISSUER=https://localhost
FRONTEND_URL=https://localhost/login/callback
FOOTBALL_API_KEY=demo

# --- Frontend (se hornea en build; mismo origen via Nginx) ---
NEXT_PUBLIC_API_URL=https://localhost

# --- Grafana ---
GRAFANA_PASSWORD=admin123
