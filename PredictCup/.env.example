# ============================================================
# Variables de entorno — Mundial Betting System (betting-backend)
# Copia este archivo a .env y completa los valores reales.
# ============================================================

# --- Base de datos PostgreSQL (perfil prod) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/mundial_apuestas
DATABASE_USER=mundial
DATABASE_PASSWORD=changeme

# --- Redis (cola de apuestas, rankings, locks, rate limit) ---
REDIS_URL=redis://localhost:6379

# --- Google OAuth (OIDC) ---
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# --- JWT ---
JWT_ISSUER=http://localhost:8080
