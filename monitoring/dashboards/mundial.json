{
  "title": "Mundial Betting — Backend",
  "uid": "mundial-backend",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Agroal — conexiones (activas / esperando)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "agroal_active_count", "legendFormat": "activas" },
        { "expr": "agroal_available_count", "legendFormat": "disponibles" },
        { "expr": "agroal_awaiting_count", "legendFormat": "esperando" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP — peticiones por segundo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "{{method}} {{uri}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP — latencia p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[1m]))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "stat",
      "title": "JVM — memoria usada (heap)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap" }
      ]
    }
  ]
}
